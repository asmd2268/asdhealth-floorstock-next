rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownProfile() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    match /userProfiles/{uid} {
      allow get: if signedIn()
        && request.auth.uid == uid
        && resource.data.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /userRoleAssignments/{uid}/assignments/{assignmentId} {
      allow get, list: if signedIn()
        && request.auth.uid == uid
        && ownProfile().accountStatus == 'active'
        && resource.data.uid == uid
        && resource.data.tenantId == ownProfile().tenantId;
      allow create, update, delete: if false;
    }

    match /tenantDirectories/{tenantId} {
      allow get: if signedIn()
        && ownProfile().uid == request.auth.uid
        && ownProfile().accountStatus == 'active'
        && ownProfile().tenantId == tenantId
        && resource.data.tenantId == tenantId
        && resource.data.status == 'active';
      allow list, create, update, delete: if false;
    }

    match /provisioningAdministrators/{uid} {
      allow read, write: if false;
    }

    match /provisioningAuditEvents/{eventId} {
      allow read, write: if false;
    }

    match /provisioningRequestKeys/{namespaceId} {
      allow read, write: if false;
    }

    // Opaque authentication sessions are readable and writable only by the
    // server-side Admin adapter. They never contain tenant authorization data.
    match /serverSessions/{sessionId} {
      allow read, write: if false;
    }

    match /sessionTokenExchanges/{tokenFingerprint} {
      allow read, write: if false;
    }

    // Inventory is server-mediated. Catalog, hierarchy, materialized balances,
    // immutable ledgers, audit events, and request keys are never browser writable.
    match /inventoryItems/{documentId} { allow read, write: if false; }
    match /inventoryLocations/{documentId} { allow read, write: if false; }
    match /inventoryLots/{documentId} { allow read, write: if false; }
    match /floorStockConfigurations/{documentId} { allow read, write: if false; }
    match /inventoryBalances/{documentId} { allow read, write: if false; }
    match /inventoryTransactions/{transactionId} {
      allow read, write: if false;
      match /lines/{lineId} { allow read, write: if false; }
    }
    match /inventoryRequestKeys/{namespaceId} { allow read, write: if false; }
    match /inventoryAuditEvents/{eventId} { allow read, write: if false; }

    // Floor-stock requests are also fully server-mediated. Request headers,
    // nested lines, audit records, and idempotency keys are denied to browsers.
    match /floorStockRequests/{requestId} {
      allow read, write: if false;
      match /lines/{lineId} { allow read, write: if false; }
    }
    match /floorStockRequestKeys/{namespaceId} { allow read, write: if false; }
    match /floorStockRequestAuditEvents/{eventId} { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

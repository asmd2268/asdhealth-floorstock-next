# Public Firebase web configuration only. These values identify a Firebase web
# app; do not put service-account keys or other server secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-public-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-app-id

# The role switcher is off unless explicitly enabled for a local demo.
NEXT_PUBLIC_ENABLE_DEMO_ROLE_SWITCHER=false
